<?xml version="1.0" encoding="utf-8"?>
<!--
  Placeholder appcast for Pasteback. No releases exist yet; this file is
  bundled into the app and referenced via a file:// SUFeedURL so that
  "Check for Updates…" reports "up to date" instead of a network error.
  When the first release ships:
    1. Host this file at a real https URL.
    2. Set that URL as SUFeedURL in scripts/Resources/App-Info.plist (the
       build script will stop rewriting it if you remove __SU_FEED_URL__).
    3. Sign each enclosure: vendor the Sparkle repo and run
         .build/checkouts/Sparkle/sign_update dist/Pasteback-1.0.0.zip
       (uses the private key generated by `make keys` /
        generate_update_keys.swift) and paste the edSignature + length
       attributes onto the enclosure.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>Pasteback Changelog</title>
    <link>https://pasteback.example/appcast.xml</link>
    <description>Most recent changes to Pasteback</description>
    <language>en</language>
  </channel>
</rss>
